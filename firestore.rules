rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt == request.time &&
             data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             (data.keys().size() == 3 || (data.keys().size() == 4 && data.displayName is string && data.displayName.size() <= 128));
    }

    // Schema Validation Blueprint: CarbonTwinState
    function isValidCarbonTwinState(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.createdAt == request.time &&
             data.inputs is map &&
             data.analysis is map &&
             data.keys().hasAll(['id', 'userId', 'createdAt', 'inputs', 'analysis']) &&
             data.keys().size() == 5;
    }

    // Rules for Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])
      );
      allow delete: if false; // User deletion is restricted

      // Subcollection for Twins history
      match /twins/{twinId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(twinId);
        allow list: if isOwner(userId) && isValidId(userId); // Explicitly verify list security
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(twinId) && isValidCarbonTwinState(incoming()) && incoming().userId == userId;
        allow update: if false; // Historical twin entries are immutable once saved
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(twinId);
      }
    }
  }
}
